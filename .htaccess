<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 1. Prevent infinite redirect loops
    RewriteRule ^public/ - [L]

    # 2. Forward ALL other traffic to the public folder
    RewriteRule ^(.*)$ public/$1 [L]

</IfModule>

# 3. Hide the .env file (Updated for WAMP / Apache 2.4+)

<FilesMatch "^\.">
Require all denied
</FilesMatch>
