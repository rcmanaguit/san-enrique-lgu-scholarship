flowchart TD
    A([Start]) --> B[/Portal Home/]
    B --> C{Action?}
    C -- Register --> D[Register]
    D --> E[Verify OTP]
    E --> F{OTP Valid?}
    F -- No --> G[/Re-enter OTP/]
    G --> E
    F -- Yes --> H[Login]
    C -- Recover --> I[Recover Account]
    I --> H
    C -- Login --> H
    H --> J{Valid Login?}
    J -- No --> K[Login Error]
    K --> L([End])
    J -- Yes --> M{User Role?}
    M -- Student --> N{Application Period Open?}
    N -- No --> O[Closed Notice]
    O --> L
    N -- Yes --> P[/Student Dashboard/]
    P --> L
    M -- Staff --> Q[/Staff Dashboard/]
    Q --> L
    M -- Admin --> R[/Admin Dashboard/]
    R --> L
